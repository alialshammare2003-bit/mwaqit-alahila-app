rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId == request.auth.uid &&
        data.email is string && data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('preferredHorizon' in data) || (data.preferredHorizon is string && data.preferredHorizon.size() <= 50)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidUserNote(data) {
      return data.id is string && isValidId(data.id) &&
        data.userId == request.auth.uid &&
        data.hijriDate is string && data.hijriDate.size() <= 30 &&
        data.title is string && data.title.size() <= 150 &&
        data.content is string && data.content.size() <= 2000;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User personal notes subcollection
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidUserNote(incoming());
        allow update: if isOwner(userId) && isValidId(noteId) && isValidUserNote(incoming()) && incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }
    }
  }
}
