{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and astronomical calendar preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL"
        },
        "preferredHorizon": {
          "type": "string",
          "maxLength": 50,
          "description": "Preferred celestial horizon (e.g., Najaf)"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["userId", "email", "createdAt", "updatedAt"]
    },
    "UserNote": {
      "title": "UserNote",
      "description": "User personal observation notes for crescent or calendar days",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Note unique ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner UID"
        },
        "hijriDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Hijri date string like 1-Shawwal-1448"
        },
        "title": {
          "type": "string",
          "maxLength": 150,
          "description": "Title of note or observation"
        },
        "content": {
          "type": "string",
          "maxLength": 2000,
          "description": "Observation details"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["id", "userId", "hijriDate", "title", "content", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document restricted to owner"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "UserNote",
      "description": "Personal observation and calendar notes subcollection"
    }
  }
}
